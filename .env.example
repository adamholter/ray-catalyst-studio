CATALYST_API_PORT=5191
CATALYST_WEB_PORT=5190

# Default is mock mode so testing does not spend money.
CATALYST_PROVIDER_MODE=mock

# Set both values for live FAL testing.
# CATALYST_PROVIDER_MODE=live
# FAL_KEY=

# Required only for prompt enhancement, brand planning, and editable mockup planning in live mode.
# Catalyst uses fal's OpenRouter-compatible endpoint by default when FAL_KEY exists.
# Set CATALYST_LLM_PROVIDER=openrouter only if you want to use a separate OpenRouter key.
# CATALYST_LLM_PROVIDER=fal-openrouter
# OPENROUTER_API_KEY=
# CATALYST_OPENROUTER_MODEL=google/gemini-3.5-flash
# CATALYST_OPENROUTER_REASONING=low
# CATALYST_IMAGE_TO_WEBSITE_AGENT_MODEL=~anthropic/claude-sonnet-latest

# Optional local run storage directory.
# CATALYST_DATA_DIR=apps/api/.data/live

# Durable hosted storage.
# Local/mock mode defaults to file storage. Hosted mode should use Postgres + R2.
# CATALYST_STORE_DRIVER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# CATALYST_MAX_STORED_RUNS=250

# Cloudflare R2, used to copy generated images/assets off fal storage.
# CATALYST_ASSET_STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional. If omitted, Catalyst serves R2 assets through /api/assets/:key.
# R2_PUBLIC_BASE_URL=

# Optional fal retention header value. Leave unset unless you have verified the
# current fal.ai object lifecycle header format for the account.
# FAL_OBJECT_LIFECYCLE_PREFERENCE=

# Optional one-process production serving override.
# CATALYST_WEB_DIST_DIR=apps/web/dist
